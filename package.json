{
  "name": "family-school",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "oak:sync": "tsx scripts/oak-sync.ts",
    "oak:types": "openapi-typescript vendor/oak/openapi.json -o src/lib/oak/openapi.d.ts",
    "plan": "tsx scripts/plan.ts",
    "e2e": "playwright test",
    "postinstall": "prisma generate",
    "start:prod": "prisma migrate deploy && node scripts/release.mjs && next start",
    "verify:loop": "tsx scripts/dev/walk-lesson.ts",
    "verify:admin": "node scripts/dev/walk-admin.mjs",
    "verify:reading": "tsx scripts/dev/walk-reading.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "openai": "^7.10.0",
    "openapi-fetch": "^0.17.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "openapi-typescript": "^7.13.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
